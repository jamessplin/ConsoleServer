#!/usr/bin/env bash
set -euo pipefail

# Installs symlinks or copies for seriald client and console CLI into /usr/local/bin
# Usage:
#   sudo ./tools/seriald/install_helpers.sh         # Install
#   sudo ./tools/seriald/install_helpers.sh --remove  # Uninstall/remove


# Adjusted for new file structure
SRC_ROOT="$(cd "$(dirname "$0")" && pwd)"

CLIENT_SRC="$SRC_ROOT/src/client.py"
CLI_SRC="$SRC_ROOT/src/console_cli.py"
STATUS_SRC="$SRC_ROOT/src/status.py"
DISPATCH_SRC="$SRC_ROOT/src/console-ssh-dispatch.sh"
SETUP_SSH_DISPATCH_SRC="$SRC_ROOT/src/setup_ssh_dispatch.py"
SERVER_SRC="$SRC_ROOT/src/server.py"
CONFIG_SRC="$SRC_ROOT/config/config.json"
SERVICE_SRC="$SRC_ROOT/service/seriald.service"

CLIENT_DST="/usr/local/bin/seriald-client"
CLI_DST="/usr/local/bin/console-cli"
STATUS_DST="/usr/local/bin/seriald-status"
DISPATCH_DST="/usr/local/bin/console-ssh-dispatch.sh"
SETUP_SSH_DISPATCH_DST="/usr/local/bin/setup_ssh_dispatch.py"
SERVER_DST="/usr/local/bin/server.py"
CONFIG_DST="/etc/seriald/config.json"
SERVICE_DST="/etc/systemd/system/seriald.service"

install_file() {
  local src="$1" dst="$2"
  if [[ ! -f "$src" ]]; then
    echo "ERROR: missing $src" >&2
    exit 1
  fi
  # Prefer copy to avoid symlink traversal issues in ForceCommand
  install -m 0755 "$src" "$dst"
  echo "Installed: $dst"
}

generate_dispatch_script() {
  local config="$1"
  local template="$SRC_ROOT/src/console-ssh-dispatch.sh.j2"
  local output="$SRC_ROOT/src/console-ssh-dispatch.sh"

  if [[ ! -f "$config" ]]; then
    echo "ERROR: missing config $config" >&2
    exit 1
  fi

  if [[ ! -f "$template" ]]; then
    echo "ERROR: missing template $template" >&2
    exit 1
  fi

  BASE_PORT=$(python3 "$SRC_ROOT/config/get_base_port.py" "$config")
  echo "[INFO] BASE_PORT is $BASE_PORT"
  sed "s/{{BASE_PORT}}/$BASE_PORT/g" "$template" > "$output"
  chmod +x "$output"
  echo "Generated: $output"
}

remove_installed() {
  echo "Removing installed files..."

  if [[ -f "$SERVICE_DST" ]]; then
    echo "Stopping and disabling seriald service..."
    systemctl stop seriald.service || true
    systemctl disable seriald.service || true
    rm -f "$SERVICE_DST"
    echo "Removed service file: $SERVICE_DST"
    echo "Reloading systemd daemon..."
    systemctl daemon-reload
  else
    echo "Service file not found: $SERVICE_DST"
  fi

  # Remove all SSH/systemd integration using the installed script before deleting it
  if [[ -f "$SETUP_SSH_DISPATCH_DST" ]]; then
    echo "Removing SSH/systemd integration via $SETUP_SSH_DISPATCH_DST --remove-all ..."
    sudo "$SETUP_SSH_DISPATCH_DST" --remove-all || true
  else
    echo "$SETUP_SSH_DISPATCH_DST not found, skipping SSH/systemd integration removal."
  fi

  rm -f "$CLIENT_DST" "$CLI_DST" "$STATUS_DST" "$DISPATCH_DST" "$SETUP_SSH_DISPATCH_DST" "$SERVER_DST" "$CONFIG_DST" "$SERVICE_DST"
  echo "Removed: $CLIENT_DST, $CLI_DST, $STATUS_DST, $DISPATCH_DST, $SETUP_SSH_DISPATCH_DST, $SERVER_DST, $CONFIG_DST, $SERVICE_DST"

  echo "Removal complete."
}

install_dependencies() {
  local packages=("python3-click" "python3-serial" "python3-passlib" "ser2net" "make")
  local missing_packages=()

  echo "Checking system dependencies..."
  for pkg in "${packages[@]}"; do
    if ! dpkg -l | grep -E "^ii\s+${pkg}\s" > /dev/null 2>&1; then
      missing_packages+=("$pkg")
    fi
  done

  if [[ ${#missing_packages[@]} -eq 0 ]]; then
    echo "All dependencies already installed."
    return 0
  fi

  echo "Installing missing dependencies: ${missing_packages[*]}"
  apt-get update
  apt-get install -y "${missing_packages[@]}"
  echo "Dependencies installed successfully."
}

do_install() {
  local keep_config="${1:-false}"

  install_dependencies

  # Always regenerate console-ssh-dispatch.sh from template
  # - Fresh install: use repo config
  # - Upgrade: use installed config when available
  if [[ "$keep_config" == "false" ]]; then
    generate_dispatch_script "$CONFIG_SRC"
  else
    if [[ -f "$CONFIG_DST" ]]; then
      generate_dispatch_script "$CONFIG_DST"
    else
      echo "[WARN] Existing config not found at $CONFIG_DST; using repo config $CONFIG_SRC"
      generate_dispatch_script "$CONFIG_SRC"
    fi
  fi

  install_file "$CLIENT_SRC" "$CLIENT_DST"
  install_file "$CLI_SRC" "$CLI_DST"
  install_file "$STATUS_SRC" "$STATUS_DST"
  install_file "$DISPATCH_SRC" "$DISPATCH_DST"
  install_file "$SETUP_SSH_DISPATCH_SRC" "$SETUP_SSH_DISPATCH_DST"
  install_file "$SERVER_SRC" "$SERVER_DST"

  if [[ "$keep_config" == "false" ]]; then
    # Fresh install: deploy config and set up SSH dispatch
    install -D -m 0644 "$CONFIG_SRC" "$CONFIG_DST"
    echo "Installed: $CONFIG_DST"

    BASE_PORT=$(python3 "$(dirname "$CONFIG_SRC")/get_base_port.py" "$CONFIG_SRC")

    echo "Setting up SSH dispatch and secondary sshd..."
    sudo /usr/local/bin/setup_ssh_dispatch.py -s $((BASE_PORT + 1)) -e $((BASE_PORT + 24)) \
      --address-family inet \
      --port22-dualstack \
      --max-ports-per-sshd 16 \
      --split-at-port $((BASE_PORT + 12)) \
      --enable-second-sshd \
      --second-sshd-config /etc/ssh/sshd_config_seriald2 \
      --second-sshd-service ssh-seriald2.service
  else
    echo "[INFO] Keeping existing config: $CONFIG_DST"
  fi

  echo "Installing and enabling systemd service..."

  if [[ ! -f "$SERVICE_SRC" ]]; then
    echo "ERROR: missing $SERVICE_SRC" >&2
    exit 1
  fi

  install -D -m 0644 "$SERVICE_SRC" "$SERVICE_DST"
  echo "Copied service file to $SERVICE_DST"

  echo "Reloading systemd daemon..."
  systemctl daemon-reload

  echo "Enabling seriald service to start on boot..."
  systemctl enable seriald.service

  if [[ "$keep_config" == "false" ]]; then
    echo "Starting seriald service..."
    systemctl start seriald.service
  else
    echo "Restarting seriald service to apply upgrade..."
    systemctl restart seriald.service
  fi

  echo "Systemd service setup complete. Use 'systemctl status seriald.service' to check its status."
}

main() {
  if [[ $EUID -ne 0 ]]; then
    echo "Please run as root (sudo)." >&2
    exit 1
  fi

  if [[ "${1:-}" == "--remove" ]]; then
    remove_installed
    exit 0
  fi

  if [[ "${1:-}" == "--upgrade" ]]; then
    do_install true
    exit 0
  fi

  do_install false
}

main "$@"
