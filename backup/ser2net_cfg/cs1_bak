%YAML 1.1
---
define: &banner |
  \r\nser2net port \p device \d [\B]\r\n\r\n

connection:
  com1_telnet:
    accepter: telnet,50001
    enable: on
    options:
      banner: *banner
      max-connections: 4
      kickolduser: false
    connector:
      type: serialdev
      options:
        device: /dev/ttyUSB0
        baudrate: 115200
        databits: 8
        stopbits: 1
        parity: none
        xonxoff: false
        rtscts: true